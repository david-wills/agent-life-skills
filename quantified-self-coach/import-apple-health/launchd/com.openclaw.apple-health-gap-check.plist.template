<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openclaw.apple-health-gap-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>{{HOME}}/.openclaw/workspace/skills/import-apple-health/scripts/gap_check.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{HOME}}/.openclaw/logs/apple-health-gap-check.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/.openclaw/logs/apple-health-gap-check.err</string>

    <key>WorkingDirectory</key>
    <string>{{HOME}}/.openclaw/workspace</string>
</dict>
</plist>
