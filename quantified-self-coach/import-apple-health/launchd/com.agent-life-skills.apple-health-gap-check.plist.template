<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/render_launchd.py, which fills the HOME, REPO and PYTHON placeholders. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-life-skills.apple-health-gap-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{REPO}}/quantified-self-coach/import-apple-health/scripts/gap_check.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{REPO}}/_data/logs/apple-health-gap-check.log</string>

    <key>StandardErrorPath</key>
    <string>{{REPO}}/_data/logs/apple-health-gap-check.err</string>

    <key>WorkingDirectory</key>
    <string>{{REPO}}</string>
</dict>
</plist>
